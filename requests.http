@baseUrl = http://localhost:3000
@password = correct-horse-battery-staple

@aliceId = 11111111-1111-4111-8111-111111111111
@bobId = 22222222-2222-4222-8222-222222222222
@carolId = 33333333-3333-4333-8333-333333333333

@projectA = aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
@projectB = bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb

@taskA1 = aaaaaaaa-0000-4000-8000-000000000001
@taskA2 = aaaaaaaa-0000-4000-8000-000000000002
@taskB1 = bbbbbbbb-0000-4000-8000-000000000001
@taskB2 = bbbbbbbb-0000-4000-8000-000000000002

@aliceToken = {{loginAlice.response.body.token}}
@bobToken = {{loginBob.response.body.token}}
@carolToken = {{loginCarol.response.body.token}}

### Health check
GET {{baseUrl}}/health

### Log in as Alice
# @name loginAlice
POST {{baseUrl}}/auth/login 
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "{{password}}"
}

### Log in as Bob
# @name loginBob
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "bob@example.com",
  "password": "{{password}}"
}

### Log in as Carol
# @name loginCarol
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "carol@example.com",
  "password": "{{password}}"
}

### 1. Bob deletes task A1 in Project A
DELETE {{baseUrl}}/projects/{{projectA}}/tasks/{{taskA1}}
Authorization: Bearer {{bobToken}}

### 1. Alice lists Project A's tasks
GET {{baseUrl}}/projects/{{projectA}}/tasks
Authorization: Bearer {{aliceToken}}

### 2. Carol deletes task A1
DELETE {{baseUrl}}/projects/{{projectA}}/tasks/{{taskA1}}
Authorization: Bearer {{carolToken}}

### 3. Alice deletes task A1
DELETE {{baseUrl}}/projects/{{projectA}}/tasks/{{taskA1}}
Authorization: Bearer {{aliceToken}}

### 4. Bob deletes task A2 through Project B's URL
DELETE {{baseUrl}}/projects/{{projectB}}/tasks/{{taskA2}}
Authorization: Bearer {{bobToken}}

### 5. Bob updates task B1
PATCH {{baseUrl}}/projects/{{projectB}}/tasks/{{taskB1}}
Authorization: Bearer {{bobToken}}
Content-Type: application/json

{
  "title": "Set up push notifications for iOS"
}

### 5. Alice changes Bob's role to VIEWER
PATCH {{baseUrl}}/users/{{bobId}}/role
Authorization: Bearer {{aliceToken}}
Content-Type: application/json

{
  "role": "VIEWER"
}

### 5. Bob updates task B1 again with the same token
PATCH {{baseUrl}}/projects/{{projectB}}/tasks/{{taskB1}}
Authorization: Bearer {{bobToken}}
Content-Type: application/json

{
  "done": true
}

### Alice archives task A2
POST {{baseUrl}}/projects/{{projectA}}/tasks/{{taskA2}}/archive
Authorization: Bearer {{aliceToken}}
